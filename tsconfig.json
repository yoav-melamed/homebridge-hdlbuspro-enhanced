{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // ponytail: homebridge 2.x ships ESM-only types, which "node16" resolution
    // refuses to import from a CommonJS file. Staying CommonJS keeps the plugin
    // loadable on homebridge 1.6+ as engines declares; drop this and switch the
    // package to ESM when 1.x support is dropped (required for TypeScript 7).
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "lib": [
      "ES2022"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    // smart-bus ships no type declarations, so its imports resolve to `any`.
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
